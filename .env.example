# Copy to .env and replace provider values before starting.
base_url_llm=https://api.openai.com/v1
api_llm=replace-with-an-llm-api-key
model_llm=gpt-4o-mini

base_url_l3=https://api.openai.com/v1
api_l3=replace-with-an-llm-api-key
model_l3=gpt-4o-mini

L3_CHECK_THRESHOLD=10
L3_WINDOW_SIZE=10

MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=prompt_guard
AI_ENGINE_URL=http://ai-engine:8000
NODE_STATE_URL=http://node-api:5000/internal/conversation-state
NODE_ALERT_URL=http://node-api:5000/security-alert
API_ALERT_URL=http://ai-engine:8000/layer3-alert
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-token
JWT_SECRET=replace-with-a-long-random-jwt-secret
CORS_ORIGIN=http://localhost
